# Shared
ENVIRONMENT=local
APP_NAME=character-ai-starter-kit

# PostgreSQL + pgvector
POSTGRES_USER=chatkit
POSTGRES_PASSWORD=chatkit
POSTGRES_DB=chatkit
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chatkit:chatkit@postgres:5432/chatkit

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
AUTH_ISSUER=dev-local
AUTH_AUDIENCE=character-ai-starter-kit
LLM_PROVIDER=mock
MAX_PROMPT_TOKENS=8000
MAX_RESPONSE_TOKENS=1200
MAX_CONCURRENT_STREAMS_PER_USER=3
CREDIT_COST_PER_1K_TOKENS=1
MODERATION_MODE=strict

# Next.js
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000
DEV_USER_ID=dev-user

# Provider keys are intentionally optional in the starter kit.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# conversation_memories.embedding is currently fixed at 1536 dimensions.
VOYAGE_EMBEDDING_MODEL=voyage-large-2
VOYAGE_EMBEDDING_TIMEOUT_SECONDS=30
# EmbeddingService does not retry; this is the SDK-owned retry setting.
VOYAGE_EMBEDDING_MAX_RETRIES=0
