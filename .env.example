# Shared
ENVIRONMENT=local
APP_NAME=character-ai-starter-kit

# PostgreSQL + pgvector
POSTGRES_USER=chatkit
POSTGRES_PASSWORD=chatkit
POSTGRES_DB=chatkit
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://chatkit:chatkit@postgres:5432/chatkit

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_PORT=8000
CORS_ORIGINS=
AUTH_ISSUER=dev-local
AUTH_AUDIENCE=character-ai-starter-kit
# 기본 배포: 프런트와 /auth API를 같은 origin의 reverse proxy에서 제공한다.
AUTH_PUBLIC_ORIGIN=http://localhost:8000
# local 전용 false. production에서는 HTTPS + true 필수.
AUTH_SECURE_COOKIES=false
# 아래 키는 비워 두었다. docs/authentication.md의 명령으로 각각 생성한다.
AUTH_JWT_KEY=
AUTH_FLOW_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:8000/auth/google/callback
# Mailpit: docker compose --profile auth-dev up -d mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=noreply@example.com
SMTP_TLS=none
SMTP_USER=
SMTP_PASSWORD=
# production: SMTP_TLS=starttls 또는 ssl, SMTP_USER/PASSWORD 필수. 개발 대체 없음.
# 테스트 DB 이름은 반드시 test를 포함한다. PostgreSQL 통합 테스트 전용.
TEST_AUTH_DATABASE_URL=
LLM_PROVIDER=mock
MAX_PROMPT_TOKENS=8000
MAX_RESPONSE_TOKENS=1200
# Nonstream generation timeout; durable lease is timeout + 60 seconds.
# A supervisor reconciles expired requests every 15 seconds without recalling LLM.
ANSWER_TIMEOUT_SECONDS=90
MAX_CONCURRENT_STREAMS_PER_USER=3
CREDIT_COST_PER_1K_TOKENS=1
MODERATION_MODE=strict

# Next.js
WEB_PORT=3000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
INTERNAL_API_BASE_URL=http://api:8000
DEV_USER_ID=dev-user

# Provider keys are intentionally optional in the starter kit.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
# conversation_memories.embedding is currently fixed at 1536 dimensions.
VOYAGE_EMBEDDING_MODEL=voyage-large-2
VOYAGE_EMBEDDING_TIMEOUT_SECONDS=30
# EmbeddingService does not retry; this is the SDK-owned retry setting.
VOYAGE_EMBEDDING_MAX_RETRIES=0

# Asset storage (assembled once at app startup; existing files are not moved).
# test_local is forbidden when ENVIRONMENT=production.
ASSET_STORAGE_KIND=test_local
ASSET_STORAGE_ID=test-local-default
# On Linux/container deployments, set an absolute Linux path instead.
ASSET_TEST_LOCAL_ROOT=C:\testChatData
# S3 settings are required only when ASSET_STORAGE_KIND=s3. Credentials use the
# standard AWS SDK credential chain and must not be stored in this file.
ASSET_S3_BUCKET=
ASSET_S3_REGION=ap-northeast-2
ASSET_S3_KEY_PREFIX=
ASSET_S3_CONNECT_TIMEOUT_SECONDS=5
ASSET_S3_READ_TIMEOUT_SECONDS=60
ASSET_S3_MAX_ATTEMPTS=3

# Hypha durable memory (summary and embedding models are configured separately).
MEMORY_SUMMARY_PROVIDER=mock
MEMORY_SUMMARY_MODEL=mock-memory-summary
MEMORY_SUMMARY_THRESHOLD_TOKENS=4000
MEMORY_SUMMARY_BATCH_TOKENS=3000
MEMORY_RECENT_RAW_TOKENS=1200
MEMORY_SUMMARY_OUTPUT_TOKENS=700
MEMORY_SUMMARY_PROMPT_VERSION=hypha-summary-v1
MEMORY_RETRIEVAL_TOKEN_BUDGET=1200
MEMORY_RETRIEVAL_CANDIDATES=20
MEMORY_RETRIEVAL_LIMIT=8
MEMORY_WORK_LEASE_SECONDS=300
# Leave blank for voyage-large-2 (fixed 1536-dimensional storage).
VOYAGE_EMBEDDING_OUTPUT_DIMENSION=
